# Thin service listen address and port (bound to localhost by default, exposed via reverse proxy)
PORT=13000
HOST=127.0.0.1
# Render endpoint bearer token (required; fail-closed 503 if empty)
RENDER_TOKEN=
# Local Browserless WebSocket endpoint and token
BROWSERLESS_WS=ws://127.0.0.1:11300
BROWSERLESS_TOKEN=
# Frontend render host page URL
RENDER_HOST_URL=https://example.com/render.html
# Request body limit in bytes (default 5MB) and timeouts in ms (default 60s)
# MAX_BODY_BYTES=5242880
# GOTO_TIMEOUT=60000
# RENDER_TIMEOUT=60000
# Font directory containing fonts.json and font files (defaults to ./fonts)
# FONTS_DIR=./fonts
